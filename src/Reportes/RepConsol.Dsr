Attribute VB_Name = "RepConsol"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit
Private DatosInforme As ADODB.Recordset

Public Sub Preparar(ByVal Cuadricula As Object, ByVal Fecha As Date)
    Dim Fila As Long
    Set Me.DataSource = Nothing
    If Not DatosInforme Is Nothing Then DatosInforme.Close
    Set DatosInforme = New ADODB.Recordset
    DatosInforme.CursorLocation = adUseClient
    DatosInforme.Fields.Append "Codigo", adVarWChar, 18
    DatosInforme.Fields.Append "Descripcion", adVarWChar, 150
    DatosInforme.Fields.Append "Empresa", adVarWChar, 500
    DatosInforme.Fields.Append "Contacto", adVarWChar, 150
    DatosInforme.Fields.Append "Fecha", adVarWChar, 19
    DatosInforme.Fields.Append "Mensajero", adVarWChar, 150
    DatosInforme.Open
    For Fila = 1 To Cuadricula.Rows - 1
        DatosInforme.AddNew Array("Codigo", "Descripcion", "Empresa", "Contacto", "Fecha", "Mensajero"), _
            Array(Cuadricula.TextMatrix(Fila, 0), Cuadricula.TextMatrix(Fila, 7), Cuadricula.TextMatrix(Fila, 2), Cuadricula.TextMatrix(Fila, 5), Cuadricula.TextMatrix(Fila, 6), Cuadricula.TextMatrix(Fila, 8))
    Next
    PresentarDatos Fecha
End Sub

Public Sub PrepararCopia(ByVal Origen As ADODB.Recordset, ByVal Fecha As Date)
    If Origen.State <> adStateOpen Then Err.Raise 5, , "No esta disponible la copia del ultimo consolidado."
    Set Me.DataSource = Nothing
    If Not DatosInforme Is Nothing Then
        If DatosInforme.State <> adStateClosed Then DatosInforme.Close
    End If
    Set DatosInforme = Origen.Clone
    PresentarDatos Fecha
End Sub

Private Sub PresentarDatos(ByVal Fecha As Date)
    Dim Control As Object
    If DatosInforme.RecordCount > 0 Then DatosInforme.MoveFirst
    Me.Sections("Sección3").Controls("Etiqueta10").Caption = Format$(DatosInforme.RecordCount, "000000")
    Me.Sections("Sección4").Controls("Etiqueta11").Caption = Format$(Fecha, "dd/mm/yyyy")
    For Each Control In Me.Sections("Sección1").Controls
        Control.CanGrow = True
    Next
    Set Me.DataSource = DatosInforme
    Me.Refresh
End Sub

Private Sub DataReport_Terminate()
    If Not DatosInforme Is Nothing Then DatosInforme.Close
    Set DatosInforme = Nothing
End Sub